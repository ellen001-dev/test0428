---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { getPath } from "@/utils/getPath";
import { slugifyStr } from "@/utils/slugify";
import { getTagCountMap, isTagValid } from "@/utils/getUniqueTags";

const posts = await getCollection("blog", ({ data }) => !data.draft);

const reviewPosts = posts
  .filter(({ data }) => data.category === "reviews")
  .sort((a, b) => b.data.pubDatetime.getTime() - a.data.pubDatetime.getTime());
const comparePosts = posts.filter(({ data }) => data.category === "compare").sort((a, b) => b.data.pubDatetime.getTime() - a.data.pubDatetime.getTime());

// 获取所有标签
const allTags = posts.flatMap(post => post.data.tags || []);

// 获取标签统计并过滤有效标签（>= 5篇文章）
const tagCountMap = getTagCountMap(posts);

// 按使用次数排序，只取有效的tag，取前6个
const popularTags = posts
  .flatMap(post => post.data.tags || [])
  .filter(tag => isTagValid(tagCountMap, tag))
  .reduce((acc, tag) => {
    if (!acc.includes(tag)) acc.push(tag);
    return acc;
  }, [] as string[])
  .sort((a, b) => (tagCountMap.get(slugifyStr(b)) || 0) - (tagCountMap.get(slugifyStr(a)) || 0))
  .slice(0, 6);
---

<Layout>
  <Header />
  
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-br from-accent-dark via-slate-900 to-accent-dark overflow-hidden">
    <div class="absolute inset-0 opacity-20">
      <div class="absolute top-0 left-0 w-96 h-96 bg-accent/30 rounded-full blur-3xl"></div>
      <div class="absolute bottom-0 right-0 w-80 h-80 bg-blue-500/20 rounded-full blur-3xl"></div>
    </div>
    
    <div class="relative mx-auto w-full max-w-6xl px-4 py-16 sm:py-24">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 bg-accent/20 backdrop-blur-sm px-4 py-2 rounded-full mb-6">
          <span class="w-2 h-2 bg-accent rounded-full animate-pulse"></span>
          <span class="text-sm text-accent font-medium">Trusted by 10,000+ Contractors</span>
        </div>
        
        <h1 class="text-4xl font-bold leading-tight text-white sm:text-5xl md:text-6xl">
          ServiceToolBase
          <br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-accent to-blue-400">
            Management Software
          </span>
        </h1>
        <p class="mt-6 max-w-2xl text-lg text-gray-300 leading-relaxed">
          Real screenshots. Real costs. No vendor bias. Find the right tool for your HVAC, plumbing, or electrical business.
        </p>
        
        <!-- CTA Button -->
        <div class="mt-10 flex flex-col gap-4 sm:flex-row">
          <a 
              href="/reviews/" 
              class="inline-flex items-center justify-center gap-2 bg-accent hover:bg-accent-light px-8 py-4 font-semibold text-white rounded-xl shadow-lg shadow-accent/30 transition-all hover:shadow-xl hover:shadow-accent/40 hover:-translate-y-0.5"
            >
              Browse All Reviews
              <IconArrowRight width={20} height={20} />
            </a>
            <a 
              href="/about/" 
              class="inline-flex items-center justify-center gap-2 border-2 border-white/20 hover:border-white/40 hover:bg-white/5 px-8 py-4 font-semibold text-white rounded-xl transition-all"
            >
              Learn More
            </a>
        </div>
      </div>

      <!-- Quick Stats Cards -->
      <div class="mt-16 grid grid-cols-2 gap-4 sm:grid-cols-4 max-w-4xl">
        <div class="bg-white/5 backdrop-blur-sm border border-white/10 p-6 rounded-xl hover:bg-white/10 transition-colors">
          <div class="text-3xl font-bold text-accent">{reviewPosts.length}</div>
          <div class="mt-1 text-sm text-gray-300">Expert Reviews</div>
        </div>
        <div class="bg-white/5 backdrop-blur-sm border border-white/10 p-6 rounded-xl hover:bg-white/10 transition-colors">
          <div class="text-3xl font-bold text-accent">{comparePosts.length}</div>
          <div class="mt-1 text-sm text-gray-300">Head-to-Head Comparisons</div>
        </div>
        <div class="bg-white/5 backdrop-blur-sm border border-white/10 p-6 rounded-xl hover:bg-white/10 transition-colors">
          <div class="text-3xl font-bold text-accent">{popularTags.length}</div>
          <div class="mt-1 text-sm text-gray-300">Categories</div>
        </div>
        <div class="bg-white/5 backdrop-blur-sm border border-white/10 p-6 rounded-xl hover:bg-white/10 transition-colors">
          <div class="text-3xl font-bold text-accent">{posts.length}</div>
          <div class="mt-1 text-sm text-gray-300">Articles</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Reviews Section -->
  <main id="main-content" data-layout="index" class="bg-background">
    {
      reviewPosts.length > 0 && (
        <section class="mx-auto w-full max-w-6xl px-4 py-16">
          <div class="flex items-center gap-3 mb-10">
            <div class="w-1 h-8 bg-accent rounded-full"></div>
            <h2 class="text-3xl font-bold text-foreground">Featured Reviews</h2>
          </div>
          
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {reviewPosts.slice(0, 6).map(post => (
              <article class="group overflow-hidden rounded-xl border border-border bg-card-bg p-6 shadow-sm hover:shadow-lg transition-all hover:-translate-y-1">
                <div class="mb-4 flex items-center gap-2 list-none">
                  {post.data.tags.slice(0, 2).map(tag => (
                    <span 
                      class="rounded-full bg-accent/10 px-3 py-1 text-xs font-medium text-accent"
                    >
                      {tag}
                    </span>
                  ))}
                </div>
                <h3 class="mb-2 text-lg font-bold text-foreground group-hover:text-accent transition-colors line-clamp-2">
                  {post.data.title}
                </h3>
                <p class="mb-4 text-sm text-muted-foreground line-clamp-2">
                  {post.data.description}
                </p>
                <a
                  href={getPath(post.id, post.filePath, true, post.data.category, true, post.data.slug)}
                  class="inline-flex items-center gap-2 text-accent hover:gap-3 transition-all"
                >
                  Read Review
                  <IconArrowRight width={16} height={16} />
                </a>
              </article>
            ))}
          </div>
          
          <div class="mt-10 text-center">
            <a 
              href="/reviews/" 
              class="inline-flex items-center gap-2 text-accent font-medium hover:gap-3 transition-all"
            >
              View All Reviews
              <IconArrowRight width={16} height={16} />
            </a>
          </div>
        </section>
      )
    }

    <!-- Popular Tags Section -->
    <section class="bg-gradient-to-br from-muted/30 to-muted/50 py-16">
      <div class="mx-auto w-full max-w-6xl px-4">
        <div class="flex items-center gap-3 mb-10">
          <div class="w-1 h-8 bg-accent rounded-full"></div>
          <h2 class="text-3xl font-bold text-foreground">Popular Categories</h2>
        </div>
        
        <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
          {popularTags.map((tag, index) => (
            <a 
              href={`/tags/${slugifyStr(tag)}/`}
              class="group flex flex-col items-center justify-center rounded-xl border border-border bg-card-bg p-5 text-center transition-all hover:border-accent hover:shadow-lg hover:-translate-y-1"
            >
              <div class="mb-3 h-10 w-10 shrink-0 flex items-center justify-center rounded-full bg-gradient-to-br from-accent/20 to-accent/5 text-sm font-bold text-accent">
                {index + 1}
              </div>
              <span class="text-sm font-medium text-foreground group-hover:text-accent transition-colors">
                {tag}
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Recent Comparisons Section -->
    {
      comparePosts.length > 0 && (
        <section class="mx-auto w-full max-w-6xl px-4 py-16">
          <div class="flex items-center gap-3 mb-10">
            <div class="w-1 h-8 bg-accent rounded-full"></div>
            <h2 class="text-3xl font-bold text-foreground">Recent Comparisons</h2>
          </div>
          
          <div class="grid gap-4 sm:grid-cols-2">
            {comparePosts.slice(0, 2).map(post => (
              <article class="flex gap-5 rounded-xl border border-border bg-card-bg p-6 hover:border-accent/50 hover:shadow-md transition-all hover:-translate-y-0.5">
                <div class="flex-1">
                  <h3 class="mb-2 text-lg font-semibold text-foreground hover:text-accent transition-colors">
                    {post.data.title}
                  </h3>
                  <p class="text-sm text-muted-foreground line-clamp-2">
                    {post.data.description}
                  </p>
                </div>
                <div class="flex flex-col items-end justify-between">
                  <span class="rounded-full bg-accent/10 px-3 py-1 text-xs font-medium text-accent">
                    {post.data.tags[0] || "Compare"}
                  </span>
                  <time class="text-xs text-muted-foreground">
                    {new Date(post.data.pubDatetime).toLocaleDateString("zh-CN")}
                  </time>
                </div>
              </article>
            ))}
          </div>
          
          <div class="mt-10 text-center">
            <a 
              href="/compare/" 
              class="inline-flex items-center gap-2 text-accent font-medium hover:gap-3 transition-all"
            >
              View All Comparisons
              <IconArrowRight width={16} height={16} />
            </a>
          </div>
        </section>
      )
    }

    <!-- CTA Section -->
    <section class="bg-gradient-to-br from-accent-dark via-slate-900 to-accent-dark py-20">
      <div class="mx-auto max-w-4xl text-center px-4">
        <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm px-4 py-2 rounded-full mb-6">
          <span class="text-sm text-white/80 font-medium">100% Independent Reviews</span>
        </div>
        
        <h2 class="text-3xl font-bold text-white sm:text-4xl md:text-5xl">
          The Work Behind the Call
        </h2>
        <p class="mt-6 text-lg text-gray-300 max-w-2xl mx-auto">
          Every review is written by a contractor, for contractors. We don't accept 
          advertising or sponsored content - our opinions are 100% independent.
        </p>
        <div class="mt-10 flex flex-col gap-4 sm:flex-row justify-center">
          <a 
            href="/reviews/" 
            class="inline-flex items-center justify-center gap-2 bg-accent hover:bg-accent-light px-8 py-4 font-semibold text-white rounded-xl shadow-lg shadow-accent/30 transition-all hover:shadow-xl"
          >
            Start Exploring
          </a>
          <a 
            href="/about/" 
            class="inline-flex items-center justify-center gap-2 border-2 border-white/20 hover:border-white/40 hover:bg-white/5 px-8 py-4 font-semibold text-white rounded-xl transition-all"
          >
            Learn About Us
          </a>
          </div>
      </div>
    </section>
  </main>
  
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
