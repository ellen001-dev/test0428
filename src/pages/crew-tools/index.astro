---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

export const title = "Crew Tools - Essential Tools for Service Contractors";
export const description = "Discover essential crew tools and equipment for HVAC, plumbing, and electrical contractors. Find the right tools for your team.";
---

<Layout title={title} description={description}>
  <Header />

  <main id="main-content" class="mx-auto w-full max-w-5xl px-4 py-8">
    <div class="mb-8">
      <h1 class="text-3xl font-bold sm:text-4xl">Crew Tools</h1>
      <p class="mt-2 text-gray-500">Essential tools and equipment for HVAC, plumbing, and electrical contractors</p>
    </div>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      <a 
        href="/crew-tools/pipe-freeze-kit/" 
        class="group p-6 bg-gradient-to-br from-accent/10 to-accent/5 rounded-xl border-2 border-accent hover:shadow-lg transition-all duration-300"
      >
        <div class="w-12 h-12 bg-accent rounded-lg flex items-center justify-center mb-4 group-hover:bg-accent-dark transition-colors">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Pipe Freeze Kit</h3>
        <p class="text-gray-500 text-sm">Professional CO2 kit that freezes pipes in 5 minutes without draining.</p>
        <div class="mt-3 inline-flex items-center text-accent text-sm font-medium">
          Shop Now <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
        </div>
      </a>

      <a 
        href="/crew-tools/hydraulic-knockout-punch/" 
        class="group p-6 bg-gradient-to-br from-amber-100 to-amber-50 rounded-xl border-2 border-amber-500 hover:shadow-lg transition-all duration-300"
      >
        <div class="w-12 h-12 bg-amber-500 rounded-lg flex items-center justify-center mb-4 group-hover:bg-amber-600 transition-colors">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path>
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Hydraulic Knockout Punch</h3>
        <p class="text-gray-500 text-sm">10-Ton punch set for clean holes in electrical panels - no Greenlee price.</p>
        <div class="mt-3 inline-flex items-center text-amber-600 text-sm font-medium">
          Shop Now <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
        </div>
      </a>

      <a 
        href="/crew-tools/electric-wire-puller/" 
        class="group p-6 bg-gradient-to-br from-blue-100 to-blue-50 rounded-xl border-2 border-blue-500 hover:shadow-lg transition-all duration-300"
      >
        <div class="w-12 h-12 bg-blue-500 rounded-lg flex items-center justify-center mb-4 group-hover:bg-blue-600 transition-colors">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Electric Wire Puller</h3>
        <p class="text-gray-500 text-sm">1000 lbs pulling force - turns 3-man jobs into 1-man tasks.</p>
        <div class="mt-3 inline-flex items-center text-blue-600 text-sm font-medium">
          Shop Now <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
        </div>
      </a>
    </div>

    <div class="mt-12 p-6 bg-gray-50 rounded-xl">
      <h2 class="text-xl font-semibold mb-4">Looking for Something Specific?</h2>
      <p class="text-gray-600 mb-4">
        Don't see what you're looking for? We're constantly expanding our Crew Tools section. 
        Submit your requirements and we'll help find the right tools for your business.
      </p>
      <a 
        href="/contact/" 
        class="inline-flex items-center px-6 py-3 bg-accent text-white font-semibold rounded-lg hover:bg-accent-dark transition-colors"
      >
        Submit Your Requirements
        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
      </a>
    </div>
  </main>

  <Footer />
</Layout>
