---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

export const title = "Crew Tools - Essential Tools for Service Contractors";
export const description = "Discover essential crew tools and equipment for HVAC, plumbing, and electrical contractors. Find the right tools for your team.";
---

<Layout title={title} description={description}>
  <Header />

  <main id="main-content" class="mx-auto w-full max-w-5xl px-4 py-8">
    <div class="mb-8">
      <h1 class="text-3xl font-bold sm:text-4xl">Crew Tools</h1>
      <p class="mt-2 text-gray-500">Essential tools and equipment for HVAC, plumbing, and electrical contractors</p>
    </div>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      <a 
        href="/crew-tools/digital-forms/" 
        class="group p-6 bg-white rounded-xl border border-gray-200 hover:border-accent hover:shadow-lg transition-all duration-300"
      >
        <div class="w-12 h-12 bg-accent/10 rounded-lg flex items-center justify-center mb-4 group-hover:bg-accent/20 transition-colors">
          <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Digital Forms</h3>
        <p class="text-gray-500 text-sm">Streamline your work order process with digital forms and checklists.</p>
      </a>

      <a 
        href="/crew-tools/mobile-apps/" 
        class="group p-6 bg-white rounded-xl border border-gray-200 hover:border-accent hover:shadow-lg transition-all duration-300"
      >
        <div class="w-12 h-12 bg-accent/10 rounded-lg flex items-center justify-center mb-4 group-hover:bg-accent/20 transition-colors">
          <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Mobile Apps</h3>
        <p class="text-gray-500 text-sm">Access job information, schedules, and customer data on the go.</p>
      </a>

      <a 
        href="/crew-tools/equipment-trackers/" 
        class="group p-6 bg-white rounded-xl border border-gray-200 hover:border-accent hover:shadow-lg transition-all duration-300"
      >
        <div class="w-12 h-12 bg-accent/10 rounded-lg flex items-center justify-center mb-4 group-hover:bg-accent/20 transition-colors">
          <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Equipment Trackers</h3>
        <p class="text-gray-500 text-sm">Keep track of your tools, vehicles, and equipment inventory.</p>
      </a>

      <a 
        href="/crew-tools/time-tracking/" 
        class="group p-6 bg-white rounded-xl border border-gray-200 hover:border-accent hover:shadow-lg transition-all duration-300"
      >
        <div class="w-12 h-12 bg-accent/10 rounded-lg flex items-center justify-center mb-4 group-hover:bg-accent/20 transition-colors">
          <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Time Tracking</h3>
        <p class="text-gray-500 text-sm">Track hours, manage schedules, and streamline payroll.</p>
      </a>

      <a 
        href="/crew-tools/invoicing/" 
        class="group p-6 bg-white rounded-xl border border-gray-200 hover:border-accent hover:shadow-lg transition-all duration-300"
      >
        <div class="w-12 h-12 bg-accent/10 rounded-lg flex items-center justify-center mb-4 group-hover:bg-accent/20 transition-colors">
          <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Invoicing Tools</h3>
        <p class="text-gray-500 text-sm">Create professional invoices and get paid faster.</p>
      </a>

      <a 
        href="/crew-tools/communication/" 
        class="group p-6 bg-white rounded-xl border border-gray-200 hover:border-accent hover:shadow-lg transition-all duration-300"
      >
        <div class="w-12 h-12 bg-accent/10 rounded-lg flex items-center justify-center mb-4 group-hover:bg-accent/20 transition-colors">
          <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Team Communication</h3>
        <p class="text-gray-500 text-sm">Stay connected with your crew in real-time.</p>
      </a>
    </div>

    <div class="mt-12 p-6 bg-gray-50 rounded-xl">
      <h2 class="text-xl font-semibold mb-4">Looking for Something Specific?</h2>
      <p class="text-gray-600">
        Don't see what you're looking for? We're constantly expanding our Crew Tools section. 
        Check back soon for more tools and resources to help your team work smarter.
      </p>
    </div>
  </main>

  <Footer />
</Layout>
