---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

export const title = "Pro CO2 Pipe Freeze Kit - Stop Draining, Start Fixing | ServiceToolBase";
export const description = "Professional-grade CO2 pipe freeze kit for plumbers. Freeze pipes in 5 minutes without draining the system. Save time and money on every job.";
---

<Layout title={title} description={description}>
  <Header />

  <main id="main-content" class="mx-auto w-full max-w-6xl px-4 py-8">
    <!-- Module 1: Hero Section -->
    <section class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-accent to-accent-dark p-8 md:p-12">
      <div class="grid gap-8 lg:grid-cols-2 items-center">
        <div class="text-white">
          <h1 class="text-4xl font-bold leading-tight sm:text-5xl lg:text-6xl">
            Stop Draining the System.<br />
            <span class="text-accent-light">Freeze the Pipe in 5 Minutes.</span>
          </h1>
          <p class="mt-6 text-lg text-white/80 max-w-xl">
            The professional-grade CO2 pipe freeze kit that pays for itself on the very first job. 
            Designed for 1-5 man plumbing crews who need Ridgid-level reliability without the $5,000 price tag.
          </p>
          <div class="mt-8 flex flex-col sm:flex-row gap-4">
            <a 
              href="#pricing" 
              class="inline-flex items-center justify-center px-8 py-4 bg-white text-accent-dark font-semibold rounded-xl hover:bg-white/90 transition-all hover:shadow-lg"
            >
              Get Your Kit Now
              <span class="ml-2 text-sm font-normal">(Ships from US Warehouse)</span>
            </a>
          </div>
          <div class="mt-8 flex flex-wrap gap-4">
            <div class="flex items-center gap-2 bg-white/10 px-4 py-2 rounded-lg">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <span class="text-sm font-medium">30-Day Jobsite Guarantee</span>
            </div>
            <div class="flex items-center gap-2 bg-white/10 px-4 py-2 rounded-lg">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <span class="text-sm font-medium">5-Year Warranty</span>
            </div>
            <div class="flex items-center gap-2 bg-white/10 px-4 py-2 rounded-lg">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
              </svg>
              <span class="text-sm font-medium">24/7 Plumber Support</span>
            </div>
          </div>
        </div>
        <div class="relative">
          <div class="aspect-square rounded-xl overflow-hidden shadow-2xl">
            <img 
              src="https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=professional%20plumber%20using%20orange%20pipe%20freeze%20jacket%20on%20frosted%20copper%20pipe%20in%20basement%2C%20industrial%20setting%2C%20realistic%20photography%2C%20professional%20lighting&image_size=landscape_16_9"
              alt="Plumber using pipe freeze kit"
              class="w-full h-full object-cover"
            />
          </div>
          <div class="absolute -bottom-4 -right-4 bg-white rounded-xl shadow-lg p-4">
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 bg-green-100 rounded-full flex items-center justify-center">
                <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
              </div>
              <div>
                <p class="font-semibold text-gray-900">Freeze in 5 Minutes</p>
                <p class="text-sm text-gray-500">1/2" Copper Pipe</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Module 2: Quick Comparison Table -->
    <section class="mt-16">
      <div class="text-center mb-8">
        <h2 class="text-3xl font-bold text-gray-900">Why Plumbers Are Switching to Our CO2 Kit</h2>
        <p class="mt-2 text-gray-500">Compare against the market leaders and see the difference</p>
      </div>
      
      <div class="overflow-x-auto rounded-xl border border-gray-200 shadow-lg">
        <table class="w-full">
          <thead>
            <tr class="bg-gray-50">
              <th class="px-6 py-4 text-left text-sm font-semibold text-gray-700 border-b">Feature</th>
              <th class="px-6 py-4 text-center text-sm font-semibold text-accent border-b bg-accent/5">Our Pro CO2 Kit</th>
              <th class="px-6 py-4 text-center text-sm font-semibold text-gray-700 border-b">Ridgid SF-2500 (Electric)</th>
              <th class="px-6 py-4 text-center text-sm font-semibold text-gray-700 border-b">Arctic Hayes (Disposable)</th>
            </tr>
          </thead>
          <tbody>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 text-sm font-medium text-gray-900">Best For</td>
              <td class="px-6 py-4 text-sm text-center text-gray-600">Daily residential & light commercial</td>
              <td class="px-6 py-4 text-sm text-center text-gray-600">Heavy commercial (hospitals)</td>
              <td class="px-6 py-4 text-sm text-center text-gray-600">Single emergency use</td>
            </tr>
            <tr class="bg-gray-50/50 hover:bg-gray-50">
              <td class="px-6 py-4 text-sm font-medium text-gray-900">Upfront Cost</td>
              <td class="px-6 py-4 text-sm text-center font-semibold text-accent">$499</td>
              <td class="px-6 py-4 text-sm text-center font-semibold text-red-500">$5,200+</td>
              <td class="px-6 py-4 text-sm text-center text-gray-600">$45 (per can)</td>
            </tr>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 text-sm font-medium text-gray-900">Freeze Time (1/2" Copper)</td>
              <td class="px-6 py-4 text-sm text-center font-semibold text-green-600">5 Minutes</td>
              <td class="px-6 py-4 text-sm text-center text-gray-600">10 Minutes</td>
              <td class="px-6 py-4 text-sm text-center text-gray-600">15 Minutes</td>
            </tr>
            <tr class="bg-gray-50/50 hover:bg-gray-50">
              <td class="px-6 py-4 text-sm font-medium text-gray-900">Portability</td>
              <td class="px-6 py-4 text-sm text-center">
                <span class="inline-flex items-center px-3 py-1 bg-green-100 text-green-700 text-xs font-medium rounded-full">High (Fits in a bucket)</span>
              </td>
              <td class="px-6 py-4 text-sm text-center">
                <span class="inline-flex items-center px-3 py-1 bg-red-100 text-red-700 text-xs font-medium rounded-full">Low (Heavy compressor)</span>
              </td>
              <td class="px-6 py-4 text-sm text-center">
                <span class="inline-flex items-center px-3 py-1 bg-green-100 text-green-700 text-xs font-medium rounded-full">High</span>
              </td>
            </tr>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 text-sm font-medium text-gray-900">Cost Per Freeze</td>
              <td class="px-6 py-4 text-sm text-center font-semibold text-green-600">~$2.50</td>
              <td class="px-6 py-4 text-sm text-center text-gray-600">$0 (Uses electricity)</td>
              <td class="px-6 py-4 text-sm text-center font-semibold text-red-500">$45.00</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Module 3: Show Don't Tell Section -->
    <section class="mt-16">
      <div class="rounded-2xl bg-gradient-to-br from-gray-50 to-white p-8 md:p-12 border border-gray-200">
        <h2 class="text-3xl font-bold text-gray-900">Built for the Real World: How It Saves You 3 Hours Per Job</h2>
        
        <div class="mt-8 grid gap-8 lg:grid-cols-2 items-start">
          <div class="relative">
            <div class="aspect-video rounded-xl overflow-hidden shadow-lg">
              <img 
                src="https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=master%20plumber%20working%20on%20copper%20pipe%20in%20apartment%20building%20basement%2C%20professional%20tools%2C%20industrial%20lighting%2C%20realistic%20work%20scene&image_size=landscape_16_9"
                alt="Plumber working on pipe in basement"
                class="w-full h-full object-cover"
              />
            </div>
            <div class="absolute -top-3 -left-3 bg-accent text-white px-4 py-2 rounded-lg font-semibold text-sm">
              15-Year Master Plumber Tested
            </div>
          </div>
          
          <div class="space-y-6">
            <p class="text-lg text-gray-700 leading-relaxed">
              Last month, our testing team (led by a 15-year master plumber) tackled a leaking main valve in a 3-story apartment building. 
              Draining the system would have taken 3 hours and angered 12 tenants.
            </p>
            <div class="bg-white rounded-xl p-6 shadow-md border border-gray-100">
              <p class="text-gray-700 leading-relaxed">
                <span class="font-semibold text-accent">Instead,</span> we used the cold shot pipe freeze kit. We clamped the jacket onto the 3/4" copper line, 
                injected the liquid CO2, and within <span class="font-semibold text-green-600">exactly 6 minutes</span> at 68°F ambient temperature, 
                we had a solid <span class="font-semibold text-accent">3000-psi ice plug</span>.
              </p>
            </div>
            <p class="text-lg text-gray-700 leading-relaxed">
              We swapped the valve in 15 minutes, thawed the pipe with a heat gun, and were off to the next job. 
              That's the difference between billing for 4 hours of labor versus actually working for 30 minutes.
            </p>
            <div class="flex items-center gap-4 p-4 bg-accent/10 rounded-xl">
              <div class="text-center">
                <p class="text-3xl font-bold text-accent">3 Hours</p>
                <p class="text-sm text-gray-600">Saved Per Job</p>
              </div>
              <div class="w-px h-12 bg-gray-300"></div>
              <div class="text-center">
                <p class="text-3xl font-bold text-green-600">$450+</p>
                <p class="text-sm text-gray-600">Average Savings</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Module 4: Technical Specs & Compatibility -->
    <section class="mt-16">
      <div class="text-center mb-8">
        <h2 class="text-3xl font-bold text-gray-900">Will It Work on Your Next Job? (Specs & Compatibility)</h2>
        <p class="mt-2 text-gray-500">Engineered to handle the most common materials found in US residential and commercial plumbing</p>
      </div>
      
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        <div class="bg-white rounded-xl p-6 border border-gray-200 hover:border-accent transition-colors">
          <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h3 class="font-semibold text-gray-900 mb-2">Supported Materials</h3>
          <p class="text-gray-600 text-sm">Copper, Steel, Lead, Plastic (PEX, CPVC, PVC)</p>
        </div>
        
        <div class="bg-white rounded-xl p-6 border border-gray-200 hover:border-accent transition-colors">
          <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
          </div>
          <h3 class="font-semibold text-gray-900 mb-2">Pipe Sizes</h3>
          <p class="text-gray-600 text-sm">1/8" (10mm) up to 2" (60mm) pipes</p>
        </div>
        
        <div class="bg-white rounded-xl p-6 border border-gray-200 hover:border-accent transition-colors">
          <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
            </svg>
          </div>
          <h3 class="font-semibold text-gray-900 mb-2">Pressure Rating</h3>
          <p class="text-gray-600 text-sm">Up to 3000 psi (well above standard 40-80 psi)</p>
        </div>
        
        <div class="bg-white rounded-xl p-6 border border-gray-200 hover:border-accent transition-colors">
          <div class="w-12 h-12 bg-orange-100 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M12 12h.01"></path>
            </svg>
          </div>
          <h3 class="font-semibold text-gray-900 mb-2">Refrigerant</h3>
          <p class="text-gray-600 text-sm">Standard liquid CO2 with dip tube</p>
        </div>
      </div>
    </section>

    <!-- Module 5: vs. The Competition -->
    <section class="mt-16">
      <div class="rounded-2xl bg-gradient-to-br from-gray-900 to-gray-800 p-8 md:p-12">
        <h2 class="text-3xl font-bold text-white">Our Kit vs. General Wire Cold-Shot CST-2</h2>
        
        <div class="mt-8 grid gap-8 lg:grid-cols-2 items-center">
          <div class="space-y-4">
            <p class="text-gray-300 leading-relaxed">
              If you've been searching for the cold shot pipe freeze kit, you know the General Wire CST-2 is the industry standard. We respect their tool, but we don't respect the markup.
            </p>
            <p class="text-gray-300 leading-relaxed">
              Our kit uses the exact same thermodynamic principles—injecting <span class="text-accent-light font-semibold">-109°F (-78°C)</span> liquid CO2 into a confined jacket—but we manufacture it directly, cutting out the middleman.
            </p>
            <p class="text-gray-300 leading-relaxed">
              You get the same freezing speed, the same durable brass fittings, and the same dual-jacket capability, but you keep <span class="text-green-400 font-bold">$200</span> in your pocket.
            </p>
          </div>
          
          <div class="bg-white/10 rounded-xl p-6 backdrop-blur-sm">
            <div class="flex items-center gap-4 mb-4">
              <div class="w-16 h-16 bg-accent rounded-lg flex items-center justify-center">
                <span class="text-2xl font-bold text-white">Ours</span>
              </div>
              <div class="text-white">
                <p class="font-semibold">Pro CO2 Pipe Freeze Kit</p>
                <p class="text-accent-light font-bold text-xl">$499</p>
              </div>
            </div>
            <div class="flex items-center gap-4 mb-4">
              <div class="w-16 h-16 bg-gray-600 rounded-lg flex items-center justify-center">
                <span class="text-lg font-bold text-white">GW</span>
              </div>
              <div class="text-white">
                <p class="font-semibold">General Wire CST-2</p>
                <p class="text-gray-400 font-bold text-xl">$699+</p>
              </div>
            </div>
            <div class="pt-4 border-t border-gray-700">
              <div class="flex items-center justify-between">
                <span class="text-gray-400">Your Savings</span>
                <span class="text-green-400 font-bold text-xl">$200+</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Module 6: FAQ -->
    <section class="mt-16">
      <div class="text-center mb-8">
        <h2 class="text-3xl font-bold text-gray-900">Frequently Asked Questions from the Field</h2>
      </div>
      
      <div class="max-w-3xl mx-auto space-y-4">
        <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
          <button 
            class="w-full px-6 py-4 text-left flex items-center justify-between hover:bg-gray-50 transition-colors"
            onclick="this.nextElementSibling.classList.toggle('hidden')"
          >
            <span class="font-semibold text-gray-900">Can I use a pipe freeze kit on PEX pipes?</span>
            <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div class="px-6 pb-4">
            <p class="text-gray-600">
              Absolutely. PEX actually freezes slightly faster than copper because it doesn't conduct ambient heat as quickly. Just ensure you don't strike the frozen PEX with a hammer, as extreme cold makes plastic temporarily brittle.
            </p>
          </div>
        </div>
        
        <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
          <button 
            class="w-full px-6 py-4 text-left flex items-center justify-between hover:bg-gray-50 transition-colors"
            onclick="this.nextElementSibling.classList.toggle('hidden')"
          >
            <span class="font-semibold text-gray-900">How long does the ice plug last?</span>
            <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div class="px-6 pb-4">
            <p class="text-gray-600">
              As long as you keep injecting a short burst of CO2 every 2-3 minutes, the plug will last indefinitely. Once you stop, a 1/2" plug typically takes 15-20 minutes to thaw at room temperature.
            </p>
          </div>
        </div>
        
        <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
          <button 
            class="w-full px-6 py-4 text-left flex items-center justify-between hover:bg-gray-50 transition-colors"
            onclick="this.nextElementSibling.classList.toggle('hidden')"
          >
            <span class="font-semibold text-gray-900">Do I need a special CO2 tank?</span>
            <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div class="px-6 pb-4">
            <p class="text-gray-600">
              You must use a CO2 cylinder with a dip tube (siphon tube). This ensures liquid CO2, not gas, is delivered to the freeze jacket.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Module 7: Final CTA & Trust Signals -->
    <section class="mt-16">
      <div class="rounded-2xl bg-gradient-to-br from-accent to-accent-dark p-8 md:p-12 text-center">
        <h2 class="text-3xl font-bold text-white">Stop Losing Money on Draining Systems</h2>
        <p class="mt-4 text-lg text-white/80 max-w-2xl mx-auto">
          Every time you drain a system, you are losing billable hours. Add the Pro CO2 Pipe Freeze Kit to your truck today. If it doesn't save you its entire purchase price in labor hours on your very first valve swap, send it back for a full refund.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center">
          <a 
            href="#pricing" 
            class="inline-flex items-center justify-center px-8 py-4 bg-white text-accent-dark font-semibold rounded-xl hover:bg-white/90 transition-all hover:shadow-lg text-lg"
          >
            Add to Cart - $499
          </a>
          <a 
            href="#" 
            class="inline-flex items-center justify-center px-8 py-4 bg-white/10 text-white font-semibold rounded-xl hover:bg-white/20 transition-all"
          >
            Watch Demo Video
          </a>
        </div>
        <div class="mt-8 flex flex-wrap justify-center gap-6">
          <div class="flex items-center gap-2 text-white/80">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span class="text-sm">30-Day Jobsite Guarantee</span>
          </div>
          <div class="flex items-center gap-2 text-white/80">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span class="text-sm">5-Year Warranty</span>
          </div>
          <div class="flex items-center gap-2 text-white/80">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
            <span class="text-sm">24/7 Plumber Support</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Pricing Section -->
    <section id="pricing" class="mt-16">
      <div class="text-center mb-8">
        <h2 class="text-3xl font-bold text-gray-900">Get Your Pro CO2 Pipe Freeze Kit Today</h2>
        <p class="mt-2 text-gray-500">Everything you need to start freezing pipes like a pro</p>
      </div>
      
      <div class="max-w-3xl mx-auto">
        <div class="rounded-2xl border-2 border-accent shadow-xl overflow-hidden">
          <div class="bg-accent text-white p-6 text-center">
            <p class="text-sm font-medium opacity-80">Professional Grade</p>
            <p class="text-5xl font-bold mt-2">$499</p>
            <p class="text-white/80 mt-2">Free shipping within the contiguous US</p>
          </div>
          <div class="p-6">
            <h3 class="font-semibold text-lg text-gray-900 mb-4">Kit Includes:</h3>
            <ul class="space-y-3">
              <li class="flex items-center gap-3">
                <svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
