---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import KnockoutHero from "@/assets/images/hydraulic-knockout-punch-hero.png";
import KnockoutScene from "@/assets/images/hydraulic-knockout-punch-scene.png";

export const title = "10-Ton Hydraulic Knockout Punch Set - Professional Hole Punching | ServiceToolBase";
export const description = "Professional hydraulic knockout punch set for electricians. Punch perfect holes in 10-gauge steel without paying Greenlee prices. Get clean, burr-free holes in seconds.";
---

<Layout title={title} description={description}>
  <Header />

  <main id="main-content" class="mx-auto w-full max-w-6xl px-4 py-8">
    <!-- Module 1: Hero Section -->
    <section class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-amber-600 to-amber-800 p-8 md:p-12">
      <div class="grid gap-8 lg:grid-cols-2 items-center">
        <div class="text-white">
          <h1 class="text-4xl font-bold leading-tight sm:text-5xl lg:text-6xl">
            Punch Perfect Holes in 10-Gauge Steel.<br />
            <span class="text-amber-200">Without the Greenlee Price Tag.</span>
          </h1>
          <p class="mt-6 text-lg text-white/80 max-w-xl">
            The 10-Ton Hydraulic Knockout Punch Set built for daily electrical work. 
            Get clean, burr-free holes for 1/2" to 2" conduit in seconds. 
            Stop fighting with hole saws and step bits.
          </p>
          <div class="mt-8 flex flex-col sm:flex-row gap-4">
            <a 
              href="/contact/" 
              class="inline-flex items-center justify-center px-8 py-4 bg-white text-amber-800 font-semibold rounded-xl hover:bg-white/90 transition-all hover:shadow-lg"
            >
              <Request a Quote
              <span class="ml-2 text-sm font-normal">($149 – $199)</span>
            </a>
          </div>
          <div class="mt-8 flex flex-wrap gap-4">
            <div class="flex items-center gap-2 bg-white/10 px-4 py-2 rounded-lg">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <span class="text-sm font-medium">10-Ton Forged Steel</span>
            </div>
            <div class="flex items-center gap-2 bg-white/10 px-4 py-2 rounded-lg">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <span class="text-sm font-medium">Cuts 10-Gauge Steel</span>
            </div>
            <div class="flex items-center gap-2 bg-white/10 px-4 py-2 rounded-lg">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
              </svg>
              <span class="text-sm font-medium">Quality Assured</span>
            </div>
          </div>
        </div>
        <div class="relative">
          <div class="aspect-square rounded-xl overflow-hidden shadow-2xl">
            <img 
              src={KnockoutHero.src}
              alt="Hydraulic knockout punch cutting steel panel"
              class="w-full h-full object-cover"
            />
          </div>
          <div class="absolute -bottom-4 -right-4 bg-white rounded-xl shadow-lg p-4">
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 bg-amber-500 rounded-full flex items-center justify-center">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
                </svg>
              </div>
              <div>
                <p class="font-semibold text-gray-900">15-Second Holes</p>
                <p class="text-sm text-gray-500">No burrs, no mess</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Module 2: Quick Comparison Table -->
    <section class="mt-16">
      <div class="text-center mb-8">
        <h2 class="text-3xl font-bold text-gray-900">Stop Overpaying for Green Paint</h2>
        <p class="mt-2 text-gray-500">A direct comparison targeting the dominant brand</p>
      </div>
      
      <div class="overflow-x-auto rounded-xl border border-gray-200 shadow-lg">
        <table class="w-full">
          <thead>
            <tr class="bg-gray-50">
              <th class="px-6 py-4 text-left text-sm font-semibold text-gray-700 border-b">Feature</th>
              <th class="px-6 py-4 text-center text-sm font-semibold text-amber-600 border-b bg-amber-50">Our 10-Ton Knockout Set</th>
              <th class="px-6 py-4 text-center text-sm font-semibold text-gray-700 border-b">Greenlee 767</th>
              <th class="px-6 py-4 text-center text-sm font-semibold text-gray-700 border-b">Harbor Freight</th>
            </tr>
          </thead>
          <tbody>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 text-sm font-medium text-gray-900">Punching Force</td>
              <td class="px-6 py-4 text-sm text-center font-semibold text-green-600">10 Tons</td>
              <td class="px-6 py-4 text-sm text-center text-gray-600">11 Tons</td>
              <td class="px-6 py-4 text-sm text-center text-gray-600">10 Tons</td>
            </tr>
            <tr class="bg-gray-50/50 hover:bg-gray-50">
              <td class="px-6 py-4 text-sm font-medium text-gray-900">Max Capacity</td>
              <td class="px-6 py-4 text-sm text-center">10-Gauge Mild Steel</td>
              <td class="px-6 py-4 text-sm text-center">10-Gauge Mild Steel</td>
              <td class="px-6 py-4 text-sm text-center">10-Gauge Mild Steel</td>
            </tr>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 text-sm font-medium text-gray-900">Included Dies</td>
              <td class="px-6 py-4 text-sm text-center">1/2", 3/4", 1", 1-1/4", 1-1/2", 2"</td>
              <td class="px-6 py-4 text-sm text-center">1/2" to 2"</td>
              <td class="px-6 py-4 text-sm text-center">1/2" to 2"</td>
            </tr>
            <tr class="bg-gray-50/50 hover:bg-gray-50">
              <td class="px-6 py-4 text-sm font-medium text-gray-900">Pump Design</td>
              <td class="px-6 py-4 text-sm text-center">Ergonomic Hand Pump</td>
              <td class="px-6 py-4 text-sm text-center">Hand Pump</td>
              <td class="px-6 py-4 text-sm text-center">Basic Hand Pump</td>
            </tr>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 text-sm font-medium text-gray-900">Price</td>
              <td class="px-6 py-4 text-sm text-center font-semibold text-green-600">$149 – $199</td>
              <td class="px-6 py-4 text-sm text-center font-semibold text-red-500">$1,200+</td>
              <td class="px-6 py-4 text-sm text-center text-gray-600">$119 (Lower durability)</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Module 3: Show Don't Tell Section -->
    <section class="mt-16">
      <div class="rounded-2xl bg-gradient-to-br from-gray-50 to-white p-8 md:p-12 border border-gray-200">
        <h2 class="text-3xl font-bold text-gray-900">Why Electricians Are Throwing Away Their Hole Saws</h2>
        
        <div class="mt-8 grid gap-8 lg:grid-cols-2 items-start">
          <div class="relative">
            <div class="aspect-video rounded-xl overflow-hidden shadow-lg">
              <img 
                src={KnockoutScene.src}
                alt="Electrician using knockout punch on panel"
                class="w-full h-full object-cover"
              />
            </div>
            <div class="absolute -top-3 -left-3 bg-amber-500 text-white px-4 py-2 rounded-lg font-semibold text-sm">
              Professional Electrician Tested
            </div>
          </div>
          
          <div class="space-y-6">
            <p class="text-lg text-gray-700 leading-relaxed">
              If you are still using a step bit or a bi-metal hole saw to cut 2-inch holes in a breaker box, 
              you are wasting time and risking injury.
            </p>
            <div class="bg-white rounded-xl p-6 shadow-md border border-gray-100">
              <p class="text-gray-700 leading-relaxed">
                Last week, an electrician in Texas used our 10-Ton Hydraulic Knockout Punch to prep a custom 200-amp subpanel. 
                He needed six 1-1/4" holes and two 2" holes. With a hole saw, that's 30 minutes of loud, messy work, 
                plus filing down the sharp burrs. With our hydraulic punch, he drilled a pilot hole, threaded the draw stud, 
                and pumped the handle. <span class="font-semibold text-amber-600">Pop.</span> 
                A perfect, factory-smooth hole in <span class="font-semibold text-green-600">15 seconds</span>. 
                No burrs. No flying metal shards. Just clean conduit prep.
              </p>
            </div>
            <div class="flex items-center gap-4 p-4 bg-amber-50 rounded-xl">
              <div class="text-center">
                <p class="text-3xl font-bold text-amber-600">30 Minutes</p>
                <p class="text-sm text-gray-600">Time Saved per Panel</p>
              </div>
              <div class="w-px h-12 bg-amber-200"></div>
              <div class="text-center">
                <p class="text-3xl font-bold text-green-600">$180</p>
                <p class="text-sm text-gray-600">Typical Savings</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Module 4: Technical Specs & Compatibility -->
    <section class="mt-16">
      <div class="text-center mb-8">
        <h2 class="text-3xl font-bold text-gray-900">Heavy-Duty Specs for Heavy-Duty Work</h2>
      </div>
      
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        <div class="bg-white rounded-xl p-6 border border-gray-200 hover:border-amber-500 transition-colors">
          <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h3 class="font-semibold text-gray-900 mb-2">Punching Capacity</h3>
          <p class="text-gray-600 text-sm">10-gauge (3.5mm) mild steel / 12-gauge (2.5mm) stainless</p>
        </div>
        
        <div class="bg-white rounded-xl p-6 border border-gray-200 hover:border-amber-500 transition-colors">
          <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
          </div>
          <h3 class="font-semibold text-gray-900 mb-2">Die Sizes</h3>
          <p class="text-gray-600 text-sm">1/2", 3/4", 1", 1-1/4", 1-1/2", 2" conduit</p>
        </div>
        
        <div class="bg-white rounded-xl p-6 border border-gray-200 hover:border-amber-500 transition-colors">
          <div class="w-12 h-12 bg-yellow-100 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M12 12h.01"></path>
            </svg>
          </div>
          <h3 class="font-semibold text-gray-900 mb-2">Hydraulic Ram</h3>
          <p class="text-gray-600 text-sm">10-ton capacity with 1" (25mm) stroke</p>
        </div>
        
        <div class="bg-white rounded-xl p-6 border border-gray-200 hover:border-amber-500 transition-colors">
          <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
          </div>
          <h3 class="font-semibold text-gray-900 mb-2">Material</h3>
          <p class="text-gray-600 text-sm">High-carbon forged steel dies</p>
        </div>
      </div>
    </section>

    <!-- Module 5: vs. The Competition -->
    <section class="mt-16">
      <div class="rounded-2xl bg-gradient-to-br from-gray-900 to-gray-800 p-8 md:p-12">
        <h2 class="text-3xl font-bold text-white">Searching for a Greenlee Hydraulic Knockout Punch? Read This First.</h2>
        
        <div class="mt-8 grid gap-8 lg:grid-cols-2 items-center">
          <div class="space-y-4">
            <p class="text-gray-300 leading-relaxed">
              We know why you're here. You searched for a Greenlee knockout set because it's what your journeyman used. 
              It's a fantastic tool. But let's be honest: you are paying a massive premium for the brand name.
            </p>
            <p class="text-gray-300 leading-relaxed">
              Our hydraulic knockout punch kit uses the exact same mechanical advantage. The dies are machined to the same 
              conduit tolerances. The hydraulic ram delivers the same effortless punching power. If you are a union shop with 
              an unlimited tool budget, buy the Greenlee. If you are an independent contractor who wants to keep your overhead 
              low while doing professional-grade work, our $149 set is the smartest investment you can make.
            </p>
          </div>
          
          <div class="bg-white/10 rounded-xl p-6 backdrop-blur-sm">
            <div class="flex items-center gap-4 mb-4">
              <div class="w-16 h-16 bg-amber-500 rounded-lg flex items-center justify-center">
                <span class="text-2xl font-bold text-white">Ours</span>
              </div>
              <div class="text-white">
                <p class="font-semibold">10-Ton Knockout Set</p>
                <p class="text-amber-400 font-bold text-xl">$149 – $199</p>
              </div>
            </div>
            <div class="flex items-center gap-4 mb-4">
              <div class="w-16 h-16 bg-gray-600 rounded-lg flex items-center justify-center">
                <span class="text-lg font-bold text-white">G</span>
              </div>
              <div class="text-white">
                <p class="font-semibold">Greenlee 767</p>
                <p class="text-gray-400 font-bold text-xl">$1,200+</p>
              </div>
            </div>
            <div class="pt-4 border-t border-gray-700">
              <div class="flex items-center justify-between">
                <span class="text-gray-400">Your Savings</span>
                <span class="text-green-400 font-bold text-xl">$1,050+</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Module 6: FAQ -->
    <section class="mt-16">
      <div class="text-center mb-8">
        <h2 class="text-3xl font-bold text-gray-900">Common Questions Before You Buy</h2>
      </div>
      
      <div class="max-w-3xl mx-auto space-y-4">
        <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
          <button 
            class="w-full px-6 py-4 text-left flex items-center justify-between hover:bg-gray-50 transition-colors"
            onclick="this.nextElementSibling.classList.toggle('hidden')"
          >
            <span class="font-semibold text-gray-900">How to use a hydraulic knockout punch?</span>
            <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div class="px-6 pb-4">
            <p class="text-gray-600">
              It's simple. 1. Drill a pilot hole (usually 3/8" or 3/4" depending on the draw stud). 
              2. Slide the die onto the draw stud. 3. Insert the stud through the pilot hole. 
              4. Thread the punch onto the other side. 5. Pump the hydraulic handle until the metal pops.
            </p>
          </div>
        </div>
        
        <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
          <button 
            class="w-full px-6 py-4 text-left flex items-center justify-between hover:bg-gray-50 transition-colors"
            onclick="this.nextElementSibling.classList.toggle('hidden')"
          >
            <span class="font-semibold text-gray-900">Will these dies cut stainless steel?</span>
            <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div class="px-6 pb-4">
            <p class="text-gray-600">
              Yes, our dies are rated for up to 12-gauge stainless steel. However, punching stainless will dull the dies faster than mild steel or aluminum.
            </p>
          </div>
        </div>
        
        <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
          <button 
            class="w-full px-6 py-4 text-left flex items-center justify-between hover:bg-gray-50 transition-colors"
            onclick="this.nextElementSibling.classList.toggle('hidden')"
          >
            <span class="font-semibold text-gray-900">Are the threads compatible with other brands?</span>
            <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div class="px-6 pb-4">
            <p class="text-gray-600">
              Our draw studs use standard threading (3/4"-16 and 3/8"-24), which makes them compatible with many standard replacement dies on the market.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Module 7: Final CTA & Trust Signals -->
    <section class="mt-16">
      <div class="rounded-2xl bg-gradient-to-br from-amber-600 to-amber-800 p-8 md:p-12 text-center">
        <h2 class="text-3xl font-bold text-white">Stop Fighting the Panel. Start Punching.</h2>
        <p class="mt-4 text-lg text-white/80 max-w-2xl mx-auto">
          Your time is too valuable to spend 10 minutes grinding out a hole that should take 15 seconds. 
          Order the 10-Ton Hydraulic Knockout Punch Set today and experience the satisfaction of a perfect, effortless cut.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center">
          <a 
            href="/contact/" 
            class="inline-flex items-center justify-center px-8 py-4 bg-white text-amber-800 font-semibold rounded-xl hover:bg-white/90 transition-all hover:shadow-lg text-lg"
          >
            Request a Quote - $149 – $199
          </a>
          <a 
            href="#" 
            class="inline-flex items-center justify-center px-8 py-4 bg-white/10 text-white font-semibold rounded-xl hover:bg-white/20 transition-all"
          >
            Watch Demo Video
          </a>
        </div>
        <div class="mt-8 flex flex-wrap justify-center gap-6">
          <div class="flex items-center gap-2 text-white/80">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span class="text-sm">10-Ton Forged Steel</span>
          </div>
          <div class="flex items-center gap-2 text-white/80">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span class="text-sm">Cuts 10-Gauge Steel</span>
          </div>
          <div class="flex items-center gap-2 text-white/80">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
            <span class="text-sm">Quality Assured</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Pricing Section -->
    <section id="pricing" class="mt-16">
      <div class="text-center mb-8">
        <h2 class="text-3xl font-bold text-gray-900">Get Your 10-Ton Hydraulic Knockout Punch Set</h2>
        <p class="mt-2 text-gray-500">Professional-grade hole punching at a fraction of the brand-name price</p>
      </div>
      
      <div class="max-w-3xl mx-auto">
        <div class="rounded-2xl border-2 border-amber-500 shadow-xl overflow-hidden">
          <div class="bg-amber-500 text-white p-6 text-center">
            <p class="text-sm font-medium opacity-80">Professional Grade</p>
            <p class="text-5xl font-bold mt-2">$149 – $199</p>
            <p class="text-white/80 mt-2">Free shipping within the contiguous US</p>
          </div>
          <div class="p-6">
            <h3 class="font-semibold text-lg text-gray-900 mb-4">Kit Includes:</h3>
            <ul class="space-y-3">
              <li class="flex items-center gap-3">
                <svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-gray-700">10-Ton hydraulic ram with ergonomic pump</span>
              </li>
              <li class="flex items-center gap-3">
                <svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-gray-700">6 precision-machined dies: 1/2" to 2"</span>
              </li>
              <li class="flex items-center gap-3">
                <svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-gray-700">Draw studs and wrench set</span>
              </li>
              <li class="flex items-center gap-3">
                <svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
