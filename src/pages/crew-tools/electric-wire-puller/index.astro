---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

export const title = "Portable Electric Wire Puller - 1000 lbs Pulling Force | ServiceToolBase";
export const description = "Professional electric wire puller tool for electricians. Pull wire effortlessly with 1000 lbs of force. Turns 3-man jobs into 1-man tasks. Save time and reduce back strain.";
---

<Layout title={title} description={description}>
  <Header />

  <main id="main-content" class="mx-auto w-full max-w-6xl px-4 py-8">
    <!-- Module 1: Hero Section -->
    <section class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-blue-600 to-blue-800 p-8 md:p-12">
      <div class="grid gap-8 lg:grid-cols-2 items-center">
        <div class="text-white">
          <h1 class="text-4xl font-bold leading-tight sm:text-5xl lg:text-6xl">
            Stop Breaking Your Back.<br />
            <span class="text-blue-200">Let the Machine Pull the Wire.</span>
          </h1>
          <p class="mt-6 text-lg text-white/80 max-w-xl">
            The portable electric wire puller that turns a grueling 3-man job into an easy 1-man task. 
            Pull up to 1,000 lbs of force through 90-degree bends without breaking a sweat.
          </p>
          <div class="mt-8 flex flex-col sm:flex-row gap-4">
            <a 
              href="#pricing" 
              class="inline-flex items-center justify-center px-8 py-4 bg-white text-blue-800 font-semibold rounded-xl hover:bg-white/90 transition-all hover:shadow-lg"
            >
              See It In Action (And Buy Now)
            </a>
          </div>
          <div class="mt-8 flex flex-wrap gap-4">
            <div class="flex items-center gap-2 bg-white/10 px-4 py-2 rounded-lg">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <span class="text-sm font-medium">1000 lbs Pulling Force</span>
            </div>
            <div class="flex items-center gap-2 bg-white/10 px-4 py-2 rounded-lg">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <span class="text-sm font-medium">Variable Speed Control</span>
            </div>
            <div class="flex items-center gap-2 bg-white/10 px-4 py-2 rounded-lg">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
              </svg>
              <span class="text-sm font-medium">1-Year Pro Warranty</span>
            </div>
          </div>
        </div>
        <div class="relative">
          <div class="aspect-square rounded-xl overflow-hidden shadow-2xl">
            <img 
              src="https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=electric%20wire%20puller%20machine%20pulling%20thick%20electrical%20wire%20through%20conduit%2C%20professional%20electrician%20working%2C%20jobsite%20lighting%2C%20industrial%20photography&image_size=landscape_16_9"
              alt="Electric wire puller in action"
              class="w-full h-full object-cover"
            />
          </div>
          <div class="absolute -bottom-4 -right-4 bg-white rounded-xl shadow-lg p-4">
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center">
                <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
                </svg>
              </div>
              <div>
                <p class="font-semibold text-gray-900">1 Person Operation</p>
                <p class="text-sm text-gray-500">Turns 3-man job into 1-man</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Module 2: Quick Comparison Table -->
    <section class="mt-16">
      <div class="text-center mb-8">
        <h2 class="text-3xl font-bold text-gray-900">Why Manual Pulling is Costing You Money</h2>
        <p class="mt-2 text-gray-500">Compare our electric puller to traditional methods</p>
      </div>
      
      <div class="overflow-x-auto rounded-xl border border-gray-200 shadow-lg">
        <table class="w-full">
          <thead>
            <tr class="bg-gray-50">
              <th class="px-6 py-4 text-left text-sm font-semibold text-gray-700 border-b">Feature</th>
              <th class="px-6 py-4 text-center text-sm font-semibold text-blue-600 border-b bg-blue-50">Our Portable Electric Puller</th>
              <th class="px-6 py-4 text-center text-sm font-semibold text-gray-700 border-b">Manual Pulling</th>
              <th class="px-6 py-4 text-center text-sm font-semibold text-gray-700 border-b">Heavy Industrial Puller</th>
            </tr>
          </thead>
          <tbody>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 text-sm font-medium text-gray-900">Crew Required</td>
              <td class="px-6 py-4 text-sm text-center font-semibold text-green-600">1 Person</td>
              <td class="px-6 py-4 text-sm text-center text-gray-600">2-3 People</td>
              <td class="px-6 py-4 text-sm text-center text-gray-600">1-2 People</td>
            </tr>
            <tr class="bg-gray-50/50 hover:bg-gray-50">
              <td class="px-6 py-4 text-sm font-medium text-gray-900">Pulling Force</td>
              <td class="px-6 py-4 text-sm text-center font-semibold text-blue-600">Up to 1,000 lbs</td>
              <td class="px-6 py-4 text-sm text-center text-gray-600">Human limit (~150 lbs)</td>
              <td class="px-6 py-4 text-sm text-center text-gray-600">2,000 - 10,000 lbs</td>
            </tr>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 text-sm font-medium text-gray-900">Setup Time</td>
              <td class="px-6 py-4 text-sm text-center font-semibold text-green-600">&lt; 2 Minutes</td>
              <td class="px-6 py-4 text-sm text-center text-gray-600">N/A</td>
              <td class="px-6 py-4 text-sm text-center text-gray-600">15-30 Minutes</td>
            </tr>
            <tr class="bg-gray-50/50 hover:bg-gray-50">
              <td class="px-6 py-4 text-sm font-medium text-gray-900">Best For</td>
              <td class="px-6 py-4 text-sm text-center text-gray-600">Residential & Light Commercial</td>
              <td class="px-6 py-4 text-sm text-center text-gray-600">Short, straight runs</td>
              <td class="px-6 py-4 text-sm text-center text-gray-600">Heavy commercial feeders</td>
            </tr>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 text-sm font-medium text-gray-900">Price</td>
              <td class="px-6 py-4 text-sm text-center font-semibold text-green-600">$299</td>
              <td class="px-6 py-4 text-sm text-center text-gray-600">$0 (Just back pain)</td>
              <td class="px-6 py-4 text-sm text-center font-semibold text-red-500">$2,500+</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Module 3: Show Don't Tell Section -->
    <section class="mt-16">
      <div class="rounded-2xl bg-gradient-to-br from-gray-50 to-white p-8 md:p-12 border border-gray-200">
        <h2 class="text-3xl font-bold text-gray-900">How to Pull 100 Feet of 4/0 Wire by Yourself</h2>
        
        <div class="mt-8 grid gap-8 lg:grid-cols-2 items-start">
          <div class="relative">
            <div class="aspect-video rounded-xl overflow-hidden shadow-lg">
              <img 
                src="https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=electrician%20using%20portable%20wire%20puller%20machine%20on%20residential%20electrical%20panel%2C%20copper%20wire%2C%20professional%20work%20scene&image_size=landscape_16_9"
                alt="Electrician using wire puller on panel"
                class="w-full h-full object-cover"
              />
            </div>
            <div class="absolute -top-3 -left-3 bg-blue-600 text-white px-4 py-2 rounded-lg font-semibold text-sm">
              Tested by Independent Contractors
            </div>
          </div>
          
          <div class="space-y-6">
            <p class="text-lg text-gray-700 leading-relaxed">
              If you've ever tried pulling electrical wire through a long conduit with multiple 90-degree bends, 
              you know it usually requires one guy feeding, one guy pulling, and a lot of yelling.
            </p>
            <div class="bg-white rounded-xl p-6 shadow-md border border-gray-100">
              <p class="text-gray-700 leading-relaxed">
                Last month, an independent contractor in Ohio had to pull three 4/0 copper conductors through 
                100 feet of 2-inch PVC with three 90-degree sweeps. Normally, he'd have to call in a helper 
                for the day. Instead, he anchored our electric wire puller to the panel, wrapped the pulling 
                rope around the capstan, and pressed the foot pedal. The machine steadily pulled the heavy 
                gauge wire through the sweeps at <span class="font-semibold text-blue-600">15 feet per minute</span>. 
                He finished the run in under 10 minutes, completely solo. That's the power of mechanical advantage.
              </p>
            </div>
            <div class="flex items-center gap-4 p-4 bg-blue-100 rounded-xl">
              <div class="text-center">
                <p class="text-3xl font-bold text-blue-600">10 Minutes</p>
                <p class="text-sm text-gray-600">Per 100ft Run</p>
              </div>
              <div class="w-px h-12 bg-blue-300"></div>
              <div class="text-center">
                <p class="text-3xl font-bold text-green-600">66%</p>
                <p class="text-sm text-gray-600">Labor Cost Saved</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Module 4: Technical Specs & Compatibility -->
    <section class="mt-16">
      <div class="text-center mb-8">
        <h2 class="text-3xl font-bold text-gray-900">Built for the Long Haul (Specs)</h2>
      </div>
      
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        <div class="bg-white rounded-xl p-6 border border-gray-200 hover:border-blue-500 transition-colors">
          <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h3 class="font-semibold text-gray-900 mb-2">Pulling Force</h3>
          <p class="text-gray-600 text-sm">Continuous 600 lbs, peak 1,000 lbs pulling capacity</p>
        </div>
        
        <div class="bg-white rounded-xl p-6 border border-gray-200 hover:border-blue-500 transition-colors">
          <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
          </div>
          <h3 class="font-semibold text-gray-900 mb-2">Speed</h3>
          <p class="text-gray-600 text-sm">Variable speed control, up to 25 feet per minute (unloaded)</p>
        </div>
        
        <div class="bg-white rounded-xl p-6 border border-gray-200 hover:border-blue-500 transition-colors">
          <div class="w-12 h-12 bg-yellow-100 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M12 12h.01"></path>
            </svg>
          </div>
          <h3 class="font-semibold text-gray-900 mb-2">Motor</h3>
          <p class="text-gray-600 text-sm">High-torque 120V AC motor (plugs into standard jobsite outlets)</p>
        </div>
        
        <div class="bg-white rounded-xl p-6 border border-gray-200 hover:border-blue-500 transition-colors">
          <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
          </div>
          <h3 class="font-semibold text-gray-900 mb-2">Weight</h3>
          <p class="text-gray-600 text-sm">At just 35 lbs, easy to carry up ladders or into tight attics</p>
        </div>
      </div>
    </section>

    <!-- Module 5: vs. The Competition -->
    <section class="mt-16">
      <div class="rounded-2xl bg-gradient-to-br from-gray-900 to-gray-800 p-8 md:p-12">
        <h2 class="text-3xl font-bold text-white">Looking for a Greenlee Electric Wire Puller?</h2>
        
        <div class="mt-8 grid gap-8 lg:grid-cols-2 items-center">
          <div class="space-y-4">
            <p class="text-gray-300 leading-relaxed">
              Greenlee makes incredible, heavy-duty wire pullers. If you are pulling 500 MCM cable through a skyscraper, 
              you absolutely need a $3,000 Greenlee tugger.
            </p>
            <p class="text-gray-300 leading-relaxed">
              But what if you are doing residential upgrades, light commercial build-outs, or long landscape lighting runs? 
              You don't need a 100-lb machine that takes 30 minutes to set up.
            </p>
            <p class="text-gray-300 leading-relaxed">
              Our portable electric wire puller tool is designed for the 80% of jobs where you just need an extra set of 
              incredibly strong hands. It sets up in 2 minutes, anchors securely, and costs a fraction of the big industrial rigs.
            </p>
          </div>
          
          <div class="bg-white/10 rounded-xl p-6 backdrop-blur-sm">
            <div class="flex items-center gap-4 mb-4">
              <div class="w-16 h-16 bg-blue-600 rounded-lg flex items-center justify-center">
                <span class="text-2xl font-bold text-white">Ours</span>
              </div>
              <div class="text-white">
                <p class="font-semibold">Portable Electric Puller</p>
                <p class="text-blue-400 font-bold text-xl">$299</p>
              </div>
            </div>
            <div class="flex items-center gap-4 mb-4">
              <div class="w-16 h-16 bg-gray-600 rounded-lg flex items-center justify-center">
                <span class="text-lg font-bold text-white">G</span>
              </div>
              <div class="text-white">
                <p class="font-semibold">Greenlee Industrial</p>
                <p class="text-gray-400 font-bold text-xl">$2,500+</p>
              </div>
            </div>
            <div class="pt-4 border-t border-gray-700">
              <div class="flex items-center justify-between">
                <span class="text-gray-400">Your Savings</span>
                <span class="text-green-400 font-bold text-xl">$2,200+</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Module 6: FAQ -->
    <section class="mt-16">
      <div class="text-center mb-8">
        <h2 class="text-3xl font-bold text-gray-900">Questions About Pulling Power</h2>
      </div>
      
      <div class="max-w-3xl mx-auto space-y-4">
        <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
          <button 
            class="w-full px-6 py-4 text-left flex items-center justify-between hover:bg-gray-50 transition-colors"
            onclick="this.nextElementSibling.classList.toggle('hidden')"
          >
            <span class="font-semibold text-gray-900">What kind of rope should I use with this puller?</span>
            <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div class="px-6 pb-4">
            <p class="text-gray-600">
              We strongly recommend using a low-stretch, double-braided polyester pulling rope (usually 1/2" or 5/8"). 
              Never use nylon or polypropylene ropes, as they stretch and can snap back dangerously if the load releases.
            </p>
          </div>
        </div>
        
        <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
          <button 
            class="w-full px-6 py-4 text-left flex items-center justify-between hover:bg-gray-50 transition-colors"
            onclick="this.nextElementSibling.classList.toggle('hidden')"
          >
            <span class="font-semibold text-gray-900">Can it pull wire through 90-degree bends?</span>
            <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div class="px-6 pb-4">
            <p class="text-gray-600">
              Yes. The 1,000 lbs of peak force is more than enough to pull standard residential and light commercial 
              bundles through multiple 90-degree sweeps, provided you use proper wire pulling lubricant.
            </p>
          </div>
        </div>
        
        <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
          <button 
            class="w-full px-6 py-4 text-left flex items-center justify-between hover:bg-gray-50 transition-colors"
            onclick="this.nextElementSibling.classList.toggle('hidden')"
          >
            <span class="font-semibold text-gray-900">How do I anchor the machine?</span>
            <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div class="px-6 pb-4">
            <p class="text-gray-600">
              The puller comes with a heavy-duty mounting bracket that can be secured directly to the electrical panel, 
              a stud, or a standard 2-inch receiver hitch on your truck.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Module 7: Final CTA & Trust Signals -->
    <section class="mt-16">
      <div class="rounded-2xl bg-gradient-to-br from-blue-600 to-blue-800 p-8 md:p-12 text-center">
        <h2 class="text-3xl font-bold text-white">Save Your Back. Save Your Labor Costs.</h2>
        <p class="mt-4 text-lg text-white/80 max-w-2xl mx-auto">
          Stop paying a second guy just to pull wire. This machine pays for itself in one week of saved labor. 
          Order your portable electric wire puller today and start working smarter, not harder.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center">
          <a 
            href="#pricing" 
            class="inline-flex items-center justify-center px-8 py-4 bg-white text-blue-800 font-semibold rounded-xl hover:bg-white/90 transition-all hover:shadow-lg text-lg"
          >
            Buy the Electric Puller - $299
          </a>
          <a 
            href="#" 
            class="inline-flex items-center justify-center px-8 py-4 bg-white/10 text-white font-semibold rounded-xl hover:bg-white/20 transition-all"
          >
            Watch Demo Video
          </a>
        </div>
        <div class="mt-8 flex flex-wrap justify-center gap-6">
          <div class="flex items-center gap-2 text-white/80">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span class="text-sm">1000 lbs Pulling Force</span>
          </div>
          <div class="flex items-center gap-2 text-white/80">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span class="text-sm">Variable Speed Control</span>
          </div>
          <div class="flex items-center gap-2 text-white/80">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
            <span class="text-sm">1-Year Pro Warranty</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Pricing Section -->
    <section id="pricing" class="mt-16">
      <div class="text-center mb-8">
        <h2 class="text-3xl font-bold text-gray-900">Get Your Portable Electric Wire Puller</h2>
        <p class="mt-2 text-gray-500">Everything you need to start pulling wire like a pro</p>
      </div>
      
      <div class="max-w-3xl mx-auto">
        <div class="rounded-2xl border-2 border-blue-500 shadow-xl overflow-hidden">
          <div class="bg-blue-500 text-white p-6 text-center">
            <p class="text-sm font-medium opacity-80">Professional Grade</p>
            <p class="text-5xl font-bold mt-2">$299</p>
            <p class="text-white/80 mt-2">Free shipping within the contiguous US</p>
